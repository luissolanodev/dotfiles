layout {
    default_tab_template {
        children
        pane size=2 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                hide_frame_except_for_search "true"

                border_enabled  "true"
                border_char     "─"
                border_format   "#[fg=bright_black]{char}"
                border_position "top"

                format_left   " {mode} #[fg=bright_black]│ #[fg=red] {session}"
                format_center "{tabs}"
                format_right  "{command_online} #[fg=bright_black]│ {command_battery} #[fg=bright_black]│ {datetime}"
                format_space  ""

                format_hide_on_overlength "true"
                format_precedence         "crl"

                tab_normal    "#[fg=white] {index}: {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_active    "#[fg=black,bg=yellow,bold] {index}: {name}{fullscreen_indicator}{sync_indicator}{floating_indicator} "
                tab_fullscreen_indicator " □"
                tab_sync_indicator       " "
                tab_floating_indicator   " 󰉈"
                tab_separator "#[fg=bright_black] │ "

                command_online_command    "sh -c 'ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && echo \"#[fg=magenta]󰖩 on\" || echo \"#[fg=red]󰖪 off\"'"
                command_online_format     "{stdout}"
                command_online_interval   "10"
                command_online_rendermode "dynamic"

                command_battery_command    "sh -c \"~/.config/zellij/scripts/battstat -f '{i} {p}'\""
                command_battery_format     "#[fg=magenta]{stdout}"
                command_battery_interval   "60"
                command_battery_rendermode "static"

                datetime          "#[fg=blue]󰭦 {format} "
                datetime_format   "%d.%m 󰅐 %H:%M"
                datetime_timezone "America/Monterrey"

                mode_normal        "#[fg=green]NORMAL"
                mode_locked        "#[fg=bright_black]LOCKED "
                mode_resize        "#[fg=red]RESIZE"
                mode_pane          "#[fg=blue]PANE"
                mode_tab           "#[fg=bright_blue]TAB"
                mode_scroll        "#[fg=yellow]SCROLL"
                mode_enter_search  "#[fg=cyan]ENT-SEARCH"
                mode_search        "#[fg=cyan]SEARCH"
                mode_rename_tab    "#[fg=bright_blue]RENAME-TAB"
                mode_rename_pane   "#[fg=blue]RENAME-PANE"
                mode_session       "#[fg=bright_cyan]SESSION"
                mode_move          "#[fg=magenta]MOVE"
                mode_prompt        "#[fg=cyan]PROMPT"
                mode_tmux          "#[fg=bright_yellow]TMUX"
                mode_default_to_mode "tmux"
            }
        }
    }
}
